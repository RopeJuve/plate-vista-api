# Secret used to sign/verify JWTs (login, table tokens). Use a long,
# random value (32+ bytes), e.g. `openssl rand -hex 32`.
JWT_SECRET=

# MongoDB connection string.
MONGO_DB_URL=

# Port the HTTP/WebSocket server listens on. Defaults to 8080.
PORT=8080

# Comma-separated list of allowed frontend origin(s) for CORS,
# e.g. https://app.example.com,https://admin.example.com
# Leave unset only for local development.
CORS_ORIGIN=
