# Secret used to sign/verify JWTs (login, table tokens). Use a long,
# random value (32+ bytes), e.g. `openssl rand -hex 32`.
JWT_SECRET=

# MongoDB connection string. Order transactions need a replica set
# (Atlas provides one).
MONGO_DB_URL=

# Port the HTTP/WebSocket server listens on. Defaults to 8080.
PORT=8080

# Comma-separated list of allowed frontend origin(s) for CORS and the
# WebSocket upgrade check, e.g. https://app.example.com
# Required when DEPLOY_TARGET is vercel or render (the server will not start
# without it, and cross-origin requests are blocked). Optional for local.
CORS_ORIGIN=

# Number of reverse proxies in front of the app, so rate limits see the real
# client IP. Defaults to 1 on vercel/render and 0 locally.
TRUST_PROXY=

# Temporary: accept the deprecated /ws?token=<login jwt>. Defaults to true.
# Set to false once every frontend connects with /ws?ticket=.
ALLOW_LEGACY_WS_TOKEN=true

# Which process this deploy is. local (default) serves REST and /ws together.
# vercel serves REST only. render serves REST and /ws and accepts internal emits.
DEPLOY_TARGET=local

# Shared by Vercel and Render. Vercel posts live events here; Render rejects
# /internal/emit without this header value. At least 16 characters.
INTERNAL_SECRET=
RENDER_INTERNAL_URL=

# Optional. When set, exceptions are reported to Sentry.
SENTRY_DSN=
